generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model likes {
  id      Int   @id @default(autoincrement())
  post_id Int
  user_id Int
  posts   posts @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_like_post")
  users   users @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_like_user")

  @@unique([post_id, user_id], map: "unique_like")
  @@index([post_id], map: "idx_likes_post")
}

model materials {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(100)
  useful_life  Int
  cost_per_m2  Decimal   @db.Decimal(10, 2)
  permeability Decimal   @db.Decimal(5, 2)
  results      results[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model posts {
  id         Int       @id @default(autoincrement())
  title      String?   @db.VarChar(150)
  category   String    @db.VarChar(50)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  message    String
  user_id    Int
  likes      likes[]
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_post_user")
  replies    replies[]

  @@index([category], map: "idx_posts_category")
  @@index([created_at(sort: Desc)], map: "idx_posts_created_at")
}

model replies {
  id         Int       @id @default(autoincrement())
  post_id    Int
  user_id    Int
  message    String
  created_at DateTime? @default(now()) @db.Timestamp(6)
  posts      posts     @relation(fields: [post_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reply_post")
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_reply_user")

  @@index([post_id], map: "idx_replies_post")
}

model results {
  id               Int         @id @default(autoincrement())
  filtered_water   Decimal     @db.Decimal(10, 2)
  unfiltered_water Decimal     @db.Decimal(10, 2)
  application_cost Decimal     @db.Decimal(10, 2)
  useful_life      Int
  simulation_id    Int
  material_id      Int
  materials        materials   @relation(fields: [material_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_result_material")
  simulations      simulations @relation(fields: [simulation_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_result_simulation")
}

model simulations {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(100)
  created_at    DateTime? @default(now()) @db.Timestamp(6)
  area          Int
  rain_level    Int
  traffic_level Int
  user_id       Int
  results       results[]
  users         users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "fk_simulation_user")

  @@index([user_id], map: "idx_simulations_user")
}

model users {
  id            Int           @id @default(autoincrement())
  username      String        @unique @db.VarChar(50)
  email         String        @unique @db.VarChar(100)
  password      String
  profile_photo String?
  likes         likes[]
  posts         posts[]
  replies       replies[]
  simulations   simulations[]
}
